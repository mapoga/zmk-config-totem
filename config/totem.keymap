#define ZMK_POINTING_DEFAULT_MOVE_VAL 3000
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&mmv {
    time-to-max-speed-ms = <1200>;
    acceleration-exponent = <1>;
    delay-ms = <0>;
};

&msc {
    delay-ms = <0>;
    time-to-max-speed-ms = <5000>;
    acceleration-exponent = <0>;
};

/ {
    behaviors {
        HMShiftR: HMShiftR {
            compatible = "zmk,behavior-hold-tap";
            label = "HMSHIFTR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            hold-trigger-key-positions = <0 1 3 4 10 11 12 13 14 20 21 22 23 24 25 32 33 34 2>;
            hold-trigger-on-release;
            flavor = "balanced";
        };

        HMShiftL: HMShiftL {
            compatible = "zmk,behavior-hold-tap";
            label = "HMSHIFTL";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <5 6 8 9 15 16 17 18 19 26 27 28 29 30 31 36 37 7 35>;
            flavor = "balanced";
        };

        HMR: HMR {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 25 32 33 34>;
            hold-trigger-on-release;
            flavor = "balanced";
        };

        HML: HML {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 26 27 28 29 30 31 35 36 37>;
            flavor = "balanced";
        };

        del_ins: delete_insert {
            compatible = "zmk,behavior-mod-morph";
            label = "DEL_INS";
            bindings = <&kp DELETE>, <&kp INSERT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_caps_words {
            bindings = <&caps_word>;
            key-positions = <13 6>;
            layers = <0>;
            timeout-ms = <100>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
       &kp Q            &kp W            &kp E         &kp R                   &kp T        &kp Y        &kp U                   &kp I                    &kp O                 &kp P
       &HML LEFT_GUI A  &HML LEFT_ALT S  &HML LCTRL D  &HMShiftL LEFT_SHIFT F  &kp G        &kp H        &kp J                   &kp K                    &kp L                 &kp SEMICOLON
&none  &kp Z            &kp X            &kp C         &kp V                   &kp B        &kp N        &HMShiftR LEFT_SHIFT M  &HMR LEFT_CONTROL COMMA  &HMR LEFT_ALT PERIOD  &HMR LGUI SLASH  &none
                                         &kp ESCAPE    &lt 1 SPACE             &lt 2 TAB    &lt 4 ENTER  &lt 3 BACKSPACE         &kp DELETE
            >;
        };

        Symbols {
            bindings = <
       &kp F1     &kp F2        &kp F3            &kp F4          &kp F5       &kp CARET             &kp AT                 &kp HASH          &kp DOLLAR         &kp AMPERSAND
       &kp LGUI   &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &none        &kp GRAVE             &kp MINUS              &kp EQUAL         &kp STAR           &kp APOSTROPHE
&none  &kp LC(Z)  &kp LC(X)     &kp LC(C)         &kp LC(V)       &kp LC(B)    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH   &none
                                &none             &trans          &none        &trans                &kp EXCLAMATION        &kp PERCENT
            >;
        };

        Navigations {
            bindings = <
       &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3      &kp NUMBER_4    &kp NUMBER_5     &none     &kp C_AC_BACK  &kp C_AC_FORWARD  &none      &none
       &kp LGUI      &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &kp PAGE_UP      &kp LEFT  &kp DOWN       &kp UP_ARROW      &kp RIGHT  &none
&none  &kp LEFT      &kp DOWN      &kp UP_ARROW      &kp RIGHT       &kp PAGE_DOWN    &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP       &kp END    &none  &none
                                   &none             &none           &trans           &trans    &trans         &trans
            >;
        };

        Numericals {
            bindings = <
       &none   &kp N7  &kp N8      &kp N9     &none      &none       &none              &none             &none         &none
       &none   &kp N4  &kp N5      &kp N6     &none      &kp C_PREV  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP   &kp C_NEXT    &kp C_PLAY_PAUSE
&none  &kp N0  &kp N1  &kp N2      &kp N3     &none      &none       &kp LEFT_SHIFT     &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LGUI          &none
                       &kp ESCAPE  &kp SPACE  &kp TAB    &kp ENTER   &trans             &kp DELETE
            >;
        };

        Functions {
            bindings = <
       &kp F12  &kp F7  &kp F8      &kp F9     &none      &none   &none           &none             &none         &none
       &kp F11  &kp F4  &kp F5      &kp F6     &none      &none   &none           &none             &none         &none
&none  &kp F10  &kp F1  &kp F2      &kp F3     &none      &none   &kp LEFT_SHIFT  &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LGUI  &none
                        &kp ESCAPE  &kp SPACE  &kp TAB    &trans  &kp BACKSPACE   &kp DELETE
            >;
        };

        Settings {
            bindings = <
       &none  &none  &none  &none  &none     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none  &bt BT_CLR
       &none  &none  &none  &none  &none     &none         &none         &none         &none  &none
&none  &none  &none  &none  &none  &none     &none         &none         &none         &none  &none       &none
                     &none  &none  &trans    &trans        &none         &none
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        cond_nav_func {
            if-layers = <2 4>;
            then-layer = <5>;
        };
    };
};
